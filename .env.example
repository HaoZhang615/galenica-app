# Local development environment. Copy to `.env` and `export $(cat .env | xargs)`
# or set these in your shell. Leave DEMO_MOCK=1 to run fully offline.

# --- Offline demo (default): in-process synthetic data, no Databricks needed ---
DEMO_MOCK=1

# --- LIVE local mode: comment out DEMO_MOCK above and set these -----------------
# DATABRICKS_PROFILE=DEFAULT
# DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
# CATALOG=galenica_demo
# SCHEMA=forecasting
# SERVING_ENDPOINT=galenica-demand-forecast
# LLM_ENDPOINT=databricks-claude-sonnet-4-5
# AI_GATEWAY_URL=https://<workspace-id>.ai-gateway.cloud.databricks.com/mlflow/v1
#
# Lakebase connection (from `databricks database get-database-instance <name>`):
# PGHOST=instance-xxxx.database.cloud.databricks.com
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGUSER=you@example.com
# LAKEBASE_INSTANCE=galenica-app-db
